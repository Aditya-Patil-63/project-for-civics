<%- include('../partials/header') %>

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>


    <div class="hero-wrapper" style="background: transparent;">
        <div class="container">
            <div class="hero-content">
                <h1 class="animate-up">Spot It. Report It. Fix It</h1>
                <p class="animate-up delay-1">Pothole? Garbage? Broken streetlight? Snap, submit, and watch your
                    neighborhood transform. Real-time tracking, instant notifications, gamified rewards.</p>
                <div class="hero-buttons animate-up delay-2">
                    <a href="/report" class="btn btn-primary btn-lg"><i class="fas fa-camera"></i> Report an Issue</a>
                    <a href="/track" class="btn btn-secondary btn-lg"><i class="fas fa-map-marked-alt"></i> View
                        Reports</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Counter (Same as before) -->
    <div class="stats-section">
        <div class="container">
            <div class="stats-grid">
                <div class="stat-item">
                    <i class="fas fa-check-circle"></i>
                    <div class="stat-number" data-target="1250">0</div>
                    <div class="stat-label">Issues Resolved</div>
                </div>
                <div class="stat-item">
                    <i class="fas fa-users"></i>
                    <div class="stat-number" data-target="5000">0</div>
                    <div class="stat-label">Active Citizens</div>
                </div>
                <div class="stat-item">
                    <i class="fas fa-clock"></i>
                    <div class="stat-number" data-target="24">0</div>
                    <div class="stat-label">Avg. Resolution (Hrs)</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Interactive Map & Feed Section -->
    <div class="container section-map">
        <div class="section-header" style="color: white;">
            <h2><span class="pulse-dot"></span> Live City Monitor</h2>
            <p style="color: rgba(255, 255, 255, 0.8);">Real-time view of reported issues and their resolution status.
            </p>
        </div>

        <div class="dashboard-grid">
            <!-- Map Column -->
            <div class="map-column">
                <div class="map-controls">
                    <button class="filter-btn active" onclick="filterMap('All')">All</button>
                    <button class="filter-btn" onclick="filterMap('Road')">Roads</button>
                    <button class="filter-btn" onclick="filterMap('Sanitation')">Sanitation</button>
                    <button class="filter-btn" onclick="filterMap('Water')">Water</button>
                    <button class="filter-btn" onclick="filterMap('Electricity')">Electricity</button>
                </div>
                <div id="map-container" class="map-view"></div>
            </div>

            <!-- Feed Column -->
            <div class="feed-column">
                <div class="feed-header">
                    <h3>Recent Activity</h3>
                    <span class="live-badge">LIVE</span>
                </div>
                <div id="activity-feed" class="feed-list">
                    <!-- Feed items will be injected here -->
                    <div class="feed-item skeleton"></div>
                    <div class="feed-item skeleton"></div>
                    <div class="feed-item skeleton"></div>
                </div>
            </div>
        </div>
    </div>

    <style>
        /* ... Previous Hero/Stats Styles ... */
        .hero-wrapper {
            background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
            color: white;
            padding: 8rem 0 6rem;
            position: relative;
            overflow: hidden;
            margin-bottom: 0;
            clip-path: polygon(0 0, 100% 0, 100% 85%, 0 100%);
        }

        .hero-content {
            max-width: 800px;
            margin: 0 auto;
            text-align: center;
            position: relative;
            z-index: 2;
        }

        .hero-wrapper h1 {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 1.5rem;
            color: white;
            line-height: 1.1;
        }

        .hero-wrapper p {
            font-size: 1.25rem;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 2.5rem;
        }

        .btn-lg {
            padding: 1rem 2rem;
            font-size: 1.1rem;
        }

        .hero-buttons {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
        }

        .hero-buttons .btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .hero-buttons .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        .stats-section {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            padding: 3rem 0;
            margin-top: -4rem;
            position: relative;
            z-index: 3;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .stats-grid {
            display: flex;
            justify-content: space-around;
            text-align: center;
            flex-wrap: wrap;
            gap: 2rem;
        }

        .stat-item {
            flex: 1;
            min-width: 200px;
        }

        .stat-item i {
            font-size: 2.5rem;
            color: #4F46E5;
            margin-bottom: 10px;
            opacity: 0.8;
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 800;
            color: white;
        }

        .stat-label {
            color: rgba(255, 255, 255, 0.8);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.05em;
        }

        /* New Dashboard Layout */
        .section-map {
            margin-top: 4rem;
            margin-bottom: 4rem;
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 2rem;
            height: 600px;
        }

        /* Map Styles */
        .map-column {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            height: 100%;
        }

        .map-view {
            flex: 1;
            width: 100%;
            height: 100%;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.1);
            z-index: 1;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
        }

        .map-controls {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.2s;
            color: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(5px);
        }

        .filter-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            color: white;
        }

        .filter-btn.active {
            background: #4F46E5;
            color: white;
            border-color: #4F46E5;
        }

        /* Feed Styles */
        .feed-column {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            height: 100%;
        }

        .feed-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255, 255, 255, 0.02);
            color: white;
        }

        .feed-header h3 {
            font-size: 1.1rem;
            margin: 0;
        }

        .live-badge {
            background: #ef4444;
            color: white;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: bold;
            animation: pulse 2s infinite;
        }

        .feed-list {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
        }

        .feed-item {
            padding: 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            gap: 1rem;
            transition: background 0.2s;
        }

        .feed-item:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .feed-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #eff6ff;
            color: #4F46E5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .feed-content h4 {
            margin: 0 0 0.2rem 0;
            font-size: 0.95rem;
            color: white;
        }

        .feed-content p {
            margin: 0;
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.7);
        }

        .feed-time {
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.5);
            margin-top: 0.4rem;
            display: block;
        }

        /* Misc */
        .section-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .section-header h2 {
            font-size: 2.2rem;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .pulse-dot {
            width: 12px;
            height: 12px;
            background: #10b981;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 0 rgba(16, 185, 129, 0.4);
            animation: pulse-shadow 2s infinite;
        }

        @keyframes pulse {
            0% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }

            100% {
                opacity: 1;
            }
        }

        @keyframes pulse-shadow {
            0% {
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
            }

            70% {
                box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
            }
        }

        @media (max-width: 768px) {
            .dashboard-grid {
                grid-template-columns: 1fr;
                height: auto;
            }

            .map-column,
            .feed-column {
                height: 500px;
            }
        }
    </style>

    <script>
        let map, markers = [];
        const allIssues = []; // Store locally for filtering

        function initMap() {
            const defaultLat = 20.5937;
            const defaultLng = 78.9629;

            map = L.map('map-container', {
                scrollWheelZoom: false // Disable zoom on scroll
            }).setView([defaultLat, defaultLng], 5);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);

            // Force map resize to fix rendering issues
            setTimeout(() => {
                map.invalidateSize();
            }, 100);

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition((pos) => {
                    map.setView([pos.coords.latitude, pos.coords.longitude], 13);
                });
            }

            loadIssues();
        }

        function loadIssues() {
            fetch('/api/issues')
                .then(res => res.json())
                .then(issues => {
                    allIssues.push(...issues);
                    updateMapMarkers(allIssues);
                    updateFeed(issues);
                })
                .catch(err => console.error(err));
        }

        function updateMapMarkers(issues) {
            // Clear existing
            markers.forEach(m => map.removeLayer(m));
            markers = [];

            issues.forEach(issue => {
                if (issue.location && issue.location.coordinates) {
                    const [lng, lat] = issue.location.coordinates;
                    const marker = L.marker([lat, lng])
                        .bindPopup(`<b>${issue.category}</b><br>${issue.description}<br><span class="badge badge-${issue.status.toLowerCase().replace(' ', '-')}">${issue.status}</span>`);
                    marker.addTo(map);
                    markers.push(marker);
                }
            });

            if (markers.length > 0) {
                const group = new L.featureGroup(markers);
                map.fitBounds(group.getBounds(), { padding: [50, 50] });
            }
        }

        function updateFeed(issues) {
            const feedContainer = document.getElementById('activity-feed');
            feedContainer.innerHTML = '';

            // Take last 10
            const recent = issues.slice(0, 10);

            recent.forEach(addFeedItem);
        }

        function addFeedItem(issue) {
            const feedContainer = document.getElementById('activity-feed');
            const date = new Date(issue.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            const html = `
            <div class="feed-item animate-up">
                <div class="feed-icon"><i class="fas fa-exclamation-circle"></i></div>
                <div class="feed-content">
                    <h4>${issue.category} Issue Reported</h4>
                    <p>${issue.description.substring(0, 50)}...</p>
                    <span class="feed-time">${date} • ${issue.status}</span>
                </div>
            </div>
        `;
            feedContainer.insertAdjacentHTML('afterbegin', html);
        }

        function filterMap(category) {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            event.target.classList.add('active');

            if (category === 'All') {
                updateMapMarkers(allIssues);
            } else {
                const filtered = allIssues.filter(i => i.category === category);
                updateMapMarkers(filtered);
            }
        }

        // Number Counter Animation
        const counters = document.querySelectorAll('.stat-number');
        counters.forEach(counter => {
            const target = +counter.getAttribute('data-target');
            const increment = target / 100;
            const updateCount = () => {
                const c = +counter.innerText;
                if (c < target) {
                    counter.innerText = Math.ceil(c + increment);
                    setTimeout(updateCount, 20);
                } else {
                    counter.innerText = target + "+";
                }
            };
            updateCount();
        });

        document.addEventListener('DOMContentLoaded', initMap);
    </script>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/toast.js"></script>
    <script>
        // Socket Integration for Live Updates
        const socket = io();
        socket.on('new_issue', (issue) => {
            allIssues.push(issue); // Add to local list
            addFeedItem(issue); // Add to feed
            // Refresh map if current filter allows
            const currentFilter = document.querySelector('.filter-btn.active').innerText;
            if (currentFilter === 'All' || currentFilter === issue.category) {
                if (issue.location && issue.location.coordinates) {
                    const [lng, lat] = issue.location.coordinates;
                    const marker = L.marker([lat, lng])
                        .bindPopup(`<b>${issue.category}</b><br>${issue.description}`)
                        .addTo(map);
                    markers.push(marker);
                }
            }
            if (window.Toast) Toast.show('info', 'New Report', `New ${issue.category} issue reported!`);
        });
    </script>
    <%- include('../partials/footer') %>