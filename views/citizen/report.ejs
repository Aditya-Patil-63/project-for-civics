<%- include('../partials/header') %>

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <div class="overlay-bg"></div>

    <div class="container main-wrapper">
        <div class="wizard-container glass-panel">
            <!-- Progress Header -->
            <div class="wizard-header">
                <h3>Report Issue</h3>
                <div class="wizard-steps-indicator">
                    <div class="step-dot active" data-step="1"></div>
                    <div class="step-line"></div>
                    <div class="step-dot" data-step="2"></div>
                    <div class="step-line"></div>
                    <div class="step-dot" data-step="3"></div>
                </div>
                <p class="step-label" id="step-label">Select Category</p>
            </div>

            <form id="reportForm" action="/api/issues" method="POST" enctype="multipart/form-data">

                <!-- Step 1: Category Selection -->
                <div class="step-content active" id="step1">
                    <div class="category-grid">
                        <label class="category-card road-category" onclick="selectCategory(this)">
                            <input type="radio" name="category" value="Road" required>
                            <div class="icon-circle"><i class="fas fa-road"></i></div>
                            <span>Road</span>
                        </label>
                        <label class="category-card sanitation-category" onclick="selectCategory(this)">
                            <input type="radio" name="category" value="Sanitation">
                            <div class="icon-circle"><i class="fas fa-trash-alt"></i></div>
                            <span>Sanitation</span>
                        </label>
                        <label class="category-card water-category" onclick="selectCategory(this)">
                            <input type="radio" name="category" value="Water">
                            <div class="icon-circle"><i class="fas fa-water"></i></div>
                            <span>Water</span>
                        </label>
                        <label class="category-card" onclick="selectCategory(this)">
                            <input type="radio" name="category" value="Electricity">
                            <div class="icon-circle"><i class="fas fa-bolt"></i></div>
                            <span>Electricity</span>
                        </label>
                        <label class="category-card" onclick="selectCategory(this)">
                            <input type="radio" name="category" value="Public Safety">
                            <div class="icon-circle"><i class="fas fa-shield-alt"></i></div>
                            <span>Safety</span>
                        </label>
                        <label class="category-card" onclick="selectCategory(this)">
                            <input type="radio" name="category" value="Other">
                            <div class="icon-circle"><i class="fas fa-ellipsis-h"></i></div>
                            <span>Other</span>
                        </label>
                    </div>
                    <div class="step-footer">
                        <button type="button" class="btn btn-primary btn-block" onclick="nextStep(2)">Next Step <i
                                class="fas fa-arrow-right"></i></button>
                    </div>
                </div>

                <!-- Step 2: Details -->
                <div class="step-content" id="step2">
                    <div class="form-input-group">
                        <textarea name="description" id="description" rows="3" placeholder=" " required></textarea>
                        <label for="description">Describe the issue...</label>
                        <i class="fas fa-pen input-icon"></i>
                        <button type="button" id="aiSuggestBtn" class="btn btn-primary" style="margin-top: 15px; width: 100%; display: flex; justify-content: center; align-items: center; gap: 8px;" onclick="suggestCategoryAndSeverity()">✨ AI Suggest Category & Severity</button>
                    </div>

                    <div class="severity-control">
                        <label>Severity Level</label>
                        <div class="severity-slider-wrapper">
                            <input type="range" name="severity" id="severity" min="1" max="5" value="1"
                                oninput="updateSeverity(this.value)">
                            <div class="severity-labels">
                                <span class="active">Low</span>
                                <span>Mid</span>
                                <span>High</span>
                            </div>
                        </div>
                        <div class="current-severity badge-low" id="severity-badge">Low Priority</div>
                    </div>

                    <div class="upload-section">
                        <div class="upload-box" onclick="document.getElementById('photos').click()">
                            <i class="fas fa-camera"></i>
                            <p>Add Photos</p>
                            <span class="sub-text">Max 3 photos</span>
                        </div>
                        <input type="file" name="photos" id="photos" accept="image/*" multiple max="3"
                            onchange="previewImages()" style="display:none;">
                        <div id="image-preview" class="preview-strip"></div>
                    </div>

                    <div class="step-footer split">
                        <button type="button" class="btn btn-text" onclick="prevStep(1)">Back</button>
                        <button type="button" class="btn btn-primary" onclick="nextStep(3)">Location <i
                                class="fas fa-map-marker-alt"></i></button>
                    </div>
                </div>

                <!-- Step 3: Location -->
                <div class="step-content" id="step3">
                    <div class="map-wrapper">
                        <div id="mini-map"></div>
                        <button type="button" class="locate-me-btn" onclick="initMap(true)"><i
                                class="fas fa-crosshairs"></i></button>
                        <div class="location-toast" id="loc-toast">Drag marker to adjust</div>
                    </div>

                    <input type="hidden" name="latitude" id="latitude" required>
                    <input type="hidden" name="longitude" id="longitude" required>

                    <div class="step-footer split">
                        <button type="button" class="btn btn-text" onclick="prevStep(2)">Back</button>
                        <button type="submit" class="btn btn-success" id="submitBtn" disabled>Submit Report <i
                                class="fas fa-paper-plane"></i></button>
                    </div>
                </div>

            </form>
        </div>
    </div>

    <style>
        /* Global Overrides */
        /* Global Overrides */
        body {
            font-family: 'Poppins', sans-serif;
            /* Background handled by global style.css */
        }

        .main-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 85vh;
            padding-top: 2rem;
        }

        /* Glass Panel */
        /* Glass Panel */
        .glass-panel {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            width: 100%;
            max-width: 900px;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
        }

        /* Header */
        .wizard-header {
            padding: 2rem 2rem 1rem;
            text-align: center;
            background: rgba(255, 255, 255, 0.02);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .wizard-header h3 {
            margin: 0 0 1rem 0;
            font-size: 1.5rem;
            color: white;
        }

        .wizard-steps-indicator {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            margin-bottom: 0.5rem;
        }

        .step-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            transition: all 0.3s;
        }

        .step-dot.active {
            background: #4F46E5;
            transform: scale(1.3);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.3);
        }

        .step-line {
            width: 30px;
            height: 2px;
            background: rgba(255, 255, 255, 0.1);
        }

        .step-label {
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.7);
            font-weight: 500;
            margin: 0;
        }

        /* Step Content */
        .step-content {
            display: none;
            padding: 2rem;
            animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .step-content.active {
            display: block;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Category Grid */
        .category-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        @media (max-width: 768px) {
            .category-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .category-card {
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid transparent;
            border-radius: 16px;
            padding: 2rem 1rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
            background-size: cover;
            background-position: center;
        }

        /* Dark overlay for readability */
        .category-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: 0;
            transition: background 0.3s;
        }

        .category-card:hover::before {
            background: rgba(0, 0, 0, 0.4);
        }

        .category-card.road-category {
            background-image: url('https://images.unsplash.com/photo-1515162816999-a0c47dc192f7?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80');
        }

        .category-card.water-category {
            background-image: url('https://images.unsplash.com/photo-1585822766878-a28a3036666d?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80');
        }

        .category-card.sanitation-category {
            background-image: url('https://images.unsplash.com/photo-1530587191325-3db32d826c18?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80');
        }

        .category-card * {
            position: relative;
            z-index: 1;
        }

        .category-card:hover {
            background: rgba(255, 255, 255, 0.1);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
            transform: translateY(-2px);
        }

        .category-card input {
            position: absolute;
            opacity: 0;
        }

        .category-card .icon-circle {
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px;
            font-size: 1.2rem;
            color: white;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            transition: all 0.2s;
        }

        .category-card span {
            font-weight: 600;
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.9);
        }

        .category-card input:checked~.icon-circle {
            background: #4F46E5;
            color: white;
            box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3);
        }

        .category-card:has(input:checked) {
            border-color: #4F46E5;
            background: rgba(79, 70, 229, 0.1);
        }

        /* Form Inputs */
        .form-input-group {
            position: relative;
            margin-bottom: 2rem;
        }

        .form-input-group textarea {
            width: 100%;
            padding: 1rem 1rem 1rem 3rem;
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.05) !important;
            font-family: inherit;
            font-size: 1rem;
            resize: none;
            transition: all 0.2s;
            color: white;
        }

        .form-input-group textarea:focus {
            border-color: #4F46E5;
            outline: none;
            background: rgba(255, 255, 255, 0.1) !important;
            color: white;
        }

        .form-input-group label {
            position: absolute;
            left: 3rem;
            top: 1rem;
            color: rgba(255, 255, 255, 0.5);
            transition: all 0.2s;
            pointer-events: none;
            background: transparent;
        }

        .form-input-group textarea:focus~label,
        .form-input-group textarea:not(:placeholder-shown)~label {
            top: -10px;
            left: 1rem;
            font-size: 0.8rem;
            color: #bdc5fc;
            background: #1e293b;
            /* Match body bg or generic dark */
            padding: 0 5px;
            border-radius: 4px;
        }

        /* Autofill Dark Mode Fix */
        .form-input-group textarea:-webkit-autofill,
        .form-input-group textarea:-webkit-autofill:hover,
        .form-input-group textarea:-webkit-autofill:focus {
            -webkit-text-fill-color: white;
            -webkit-box-shadow: 0 0 0px 1000px #1e293b inset;
            transition: background-color 5000s ease-in-out 0s;
        }

        .input-icon {
            position: absolute;
            left: 1rem;
            top: 1.2rem;
            color: #9ca3af;
        }

        /* Severity Slider */
        .severity-control {
            background: rgba(255, 255, 255, 0.05);
            padding: 1.5rem;
            border-radius: 16px;
            margin-bottom: 2rem;
        }

        .severity-control label {
            display: block;
            margin-bottom: 1rem;
            font-weight: 600;
            color: white;
        }

        input[type=range] {
            width: 100%;
            accent-color: #4F46E5;
        }

        .severity-labels {
            display: flex;
            justify-content: space-between;
            margin-top: 5px;
            font-size: 0.75rem;
            color: #9ca3af;
        }

        #severity-badge {
            display: block;
            text-align: center;
            margin-top: 1rem;
            padding: 0.5rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .badge-low {
            background: #d1fae5;
            color: #065f46;
        }

        .badge-mid {
            background: #fef3c7;
            color: #92400e;
        }

        .badge-high {
            background: #fee2e2;
            color: #991b1b;
        }

        /* Upload */
        .upload-section {
            display: flex;
            gap: 15px;
            margin-bottom: 1rem;
        }

        .upload-box {
            width: 100px;
            height: 100px;
            border: 2px dashed rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: rgba(255, 255, 255, 0.5);
            transition: all 0.2s;
            flex-shrink: 0;
        }

        .upload-box:hover {
            border-color: #4F46E5;
            color: #4F46E5;
            background: rgba(79, 70, 229, 0.1);
        }

        .upload-box i {
            font-size: 1.5rem;
            margin-bottom: 5px;
        }

        .upload-box p {
            font-size: 0.7rem;
            margin: 0;
            font-weight: 600;
        }

        .sub-text {
            font-size: 0.6rem;
            opacity: 0.7;
        }

        .preview-strip {
            display: flex;
            gap: 10px;
            overflow-x: auto;
        }

        .preview-strip img {
            width: 100px;
            height: 100px;
            border-radius: 12px;
            object-fit: cover;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        /* Buttons */
        .step-footer {
            margin-top: 1rem;
        }

        .step-footer.split {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
        }

        .btn-block {
            width: 100%;
        }

        .btn {
            padding: 1rem 2rem;
            border-radius: 12px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: transform 0.2s;
        }

        .btn:active {
            transform: scale(0.98);
        }

        .btn-primary {
            background: #4F46E5;
            color: white;
            box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.4);
            border: none;
        }

        .btn-success {
            background: #10b981;
            color: white;
            box-shadow: 0 10px 20px -5px rgba(16, 185, 129, 0.4);
            border: none;
        }

        .btn-text {
            background: transparent;
            color: rgba(255, 255, 255, 0.7);
            border: none;
        }

        .btn-text:hover {
            color: white;
            background: rgba(255, 255, 255, 0.1);
        }

        /* Map */
        .map-wrapper {
            height: 400px;
            border-radius: 20px;
            overflow: hidden;
            position: relative;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        #mini-map {
            width: 100%;
            height: 100%;
        }

        .locate-me-btn {
            position: absolute;
            bottom: 20px;
            right: 20px;
            background: white;
            border: none;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            z-index: 500;
            cursor: pointer;
            color: #4F46E5;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.2s;
        }

        .locate-me-btn:active {
            transform: scale(0.9);
        }

        .location-toast {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.8rem;
            z-index: 500;
            pointer-events: none;
        }
    </style>

    <script>
        async function suggestCategoryAndSeverity() {
            const description = document.getElementById('description').value;
            if (description.trim().length < 10) {
                alert('Please enter at least 10 characters to use AI suggestion.');
                return;
            }

            const btn = document.getElementById('aiSuggestBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Analyzing...';
            btn.disabled = true;

            try {
                const response = await fetch('/api/issues/ai-suggest', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ description })
                });

                if (response.ok) {
                    const data = await response.json();
                    
                    if (data.category) {
                        const radios = document.querySelectorAll('input[name="category"]');
                        for (let r of radios) {
                            if (r.value === data.category || (data.category === 'Safety' && r.value === 'Public Safety')) {
                                r.checked = true;
                                selectCategory(r.closest('.category-card'));
                                break;
                            }
                        }
                    }

                    if (data.severity) {
                        document.getElementById('severity').value = data.severity;
                        updateSeverity(data.severity);
                    }
                }
            } catch (err) {
                console.error('AI Suggestion failed', err);
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

        let currentStep = 1;
        function nextStep(step) {
            if (step === 2 && !document.querySelector('input[name="category"]:checked')) return shakeForm();
            if (step === 3 && !document.getElementById('description').value) return shakeForm();

            changeStep(step);
        }

        function prevStep(step) { changeStep(step); }

        function changeStep(step) {
            // Animation Out
            document.querySelector('.step-content.active').style.opacity = '0';
            setTimeout(() => {
                document.querySelectorAll('.step-content').forEach(el => el.classList.remove('active'));
                const next = document.getElementById('step' + step);
                next.classList.add('active');
                next.style.opacity = '0';
                requestAnimationFrame(() => next.style.opacity = '1');

                // Update Header
                updateIndicator(step);

                if (step === 3) initMap();
            }, 200);
        }

        function updateIndicator(step) {
            const labels = ['Select Category', 'Details & Photos', 'Exact Location'];
            document.getElementById('step-label').innerText = labels[step - 1];

            document.querySelectorAll('.step-dot').forEach((d, i) => {
                if (i + 1 <= step) d.classList.add('active');
                else d.classList.remove('active');
            });
        }

        function selectCategory(card) {
            document.querySelectorAll('.category-card').forEach(c => c.querySelector('input').checked = false);
            card.querySelector('input').checked = true;
        }

        function updateSeverity(val) {
            const badge = document.getElementById('severity-badge');
            const labels = ['Low Priority', 'Minor Issue', 'Moderate', 'Urgent', 'Critical'];
            badge.innerText = labels[val - 1];

            badge.className = 'current-severity';
            if (val <= 2) badge.classList.add('badge-low');
            else if (val <= 4) badge.classList.add('badge-mid');
            else badge.classList.add('badge-high');
        }

        function shakeForm() {
            const container = document.querySelector('.wizard-container');
            container.style.animation = 'shake 0.4s';
            setTimeout(() => container.style.animation = '', 400);
        }

        // Map & Image logic same as before but adapted for new IDs if needed
        // ... [Reuse initMap, previewImages, setMarker from previous code] ... 


        let map, marker, mapInit = false;
        function initMap(force = false) {
            if (mapInit && !force) {
                setTimeout(() => map.invalidateSize(), 100);
                return;
            }

            if (!map) {
                map = L.map('mini-map', { zoomControl: false }).setView([20.5937, 78.9629], 5);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
            }

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(pos => {
                    const { latitude, longitude } = pos.coords;
                    setLoc(latitude, longitude);
                    map.setView([latitude, longitude], 16);
                });
            }

            map.on('click', e => setLoc(e.latlng.lat, e.latlng.lng));
            mapInit = true;
        }

        function setLoc(lat, lng) {
            if (marker) map.removeLayer(marker);
            marker = L.marker([lat, lng], { draggable: true }).addTo(map);
            document.getElementById('latitude').value = lat;
            document.getElementById('longitude').value = lng;
            document.getElementById('submitBtn').disabled = false;
            document.getElementById('loc-toast').innerText = "Location Set!";
            document.getElementById('loc-toast').style.background = "#10b981";

            marker.on('dragend', e => {
                const { lat, lng } = e.target.getLatLng();
                document.getElementById('latitude').value = lat;
                document.getElementById('longitude').value = lng;
            });
        }

        function previewImages() {
            const box = document.getElementById('image-preview');
            box.innerHTML = '';
            Array.from(document.getElementById('photos').files).forEach(f => {
                const r = new FileReader();
                r.onload = e => {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    box.appendChild(img);
                }
                r.readAsDataURL(f);
            });
        }
    </script>

    <style>
        @keyframes shake {
            0% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-10px);
            }

            50% {
                transform: translateX(10px);
            }

            75% {
                transform: translateX(-10px);
            }

            100% {
                transform: translateX(0);
            }
        }
    </style>

    <%- include('../partials/footer') %>