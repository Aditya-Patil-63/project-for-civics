<%- include('../partials/header') %>
    <div class="container">
        <div class="card">
            <a href="/worker/tasks" class="back-btn"><i class="fas fa-arrow-left"></i> Back to Tasks</a>
            <h2>Task Details</h2>

            <div class="issue-info">
                <p><strong>Category:</strong>
                    <%= task.category %>
                </p>
                <p><strong>Description:</strong>
                    <%= task.description %>
                </p>
                <p><strong>Severity:</strong>
                    <%= task.severity %>
                </p>
                <p><strong>Current Status:</strong>
                    <%= task.status %>
                </p>

                <% if(task.photos && task.photos.length> 0) { %>
                    <div class="photos">
                        <strong>Photos:</strong><br>
                        <% task.photos.forEach(photo=> { %>
                            <img src="<%= photo %>" alt="Issue Photo" style="max-width: 200px; margin: 5px;">
                            <% }) %>
                    </div>
                    <% } %>
            </div>

            <hr>

            <h3>Update Status</h3>
            <form action="/api/worker/tasks/<%= task._id %>/complete" method="POST" enctype="multipart/form-data"
                id="updateForm">
                <div class="form-group">
                    <label for="status">New Status</label>
                    <select name="status" id="status" required>
                        <option value="In Progress" <%=task.status==='In Progress' ? 'selected' : '' %>>In Progress
                        </option>
                        <option value="Resolved" <%=task.status==='Resolved' ? 'selected' : '' %>>Resolved</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="after_photo">Upload Start/Completion Photo</label>
                    <input type="file" name="after_photo" id="after_photo" accept="image/*">
                </div>

                <button type="submit" class="btn btn-success">Update Task</button>
            </form>
        </div>
    </div>

    <script src="/js/offlineSync.js"></script>
    <script>
        document.getElementById('updateForm').addEventListener('submit', function (e) {
            if (!navigator.onLine) {
                e.preventDefault();
                // Basic offline handling for visual feedback
                // Detailed queueing is in offlineSync.js, but since this is a multipart form, 
                // saving files to localStorage is tricky. 
                // For this hackathon scope, we'll alert.
                alert("You are offline. Please connect to internet to upload photos.");
            }
        });

        // Simple integration with offlineSync if we were using JSON
        // validation logic here
    </script>

    <style>
        .container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 0 1.5rem;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: #3b82f6;
            text-decoration: none;
            font-size: 0.9rem;
            margin-bottom: 1rem;
            transition: color 0.2s;
        }

        .back-btn:hover {
            color: #60a5fa;
        }

        .card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            padding: 2rem;
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .card h2 {
            color: white;
            margin: 0 0 1.5rem 0;
        }

        .card h3 {
            color: white;
            margin: 1.5rem 0 1rem 0;
        }

        .issue-info p {
            color: #94a3b8;
            margin: 0.75rem 0;
        }

        .issue-info strong {
            color: white;
        }

        .photos img {
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        hr {
            border: none;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin: 1.5rem 0;
        }

        .form-group {
            margin-bottom: 1.25rem;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
            color: #94a3b8;
        }

        select,
        input[type="file"] {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.05);
            color: white;
        }

        select option {
            background: #1e293b;
            color: white;
        }

        .btn-success {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            border: none;
            padding: 0.75rem 1.5rem;
            font-size: 1rem;
            border-radius: 8px;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
        }
    </style>
    <%- include('../partials/footer') %>