<%- include('../partials/header') %>

    <div class="dashboard-container">
        <div class="welcome-section">
            <div class="welcome-text">
                <h2>Welcome back, <%= user ? user.name : 'Worker' %>! 👋</h2>
                <p>Here's what's happening in your sector today.</p>
            </div>
            <div class="date-display">
                <%= new Date().toLocaleDateString('en-US', { weekday: 'long' , year: 'numeric' , month: 'long' ,
                    day: 'numeric' }) %>
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="stats-grid">
            <div class="stat-card pending">
                <div class="icon-wrapper">
                    <i class="fas fa-clipboard-list"></i>
                </div>
                <div class="stat-info">
                    <h3>
                        <%= totalAssigned %>
                    </h3>
                    <p>Pending Tasks</p>
                </div>
            </div>
            <div class="stat-card completed">
                <div class="icon-wrapper">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-info">
                    <h3>
                        <%= completed %>
                    </h3>
                    <p>Completed Total</p>
                </div>
            </div>
            <div class="stat-card performance">
                <div class="icon-wrapper">
                    <i class="fas fa-star"></i>
                </div>
                <div class="stat-info">
                    <h3>4.8</h3>
                    <p>Performance Rating</p>
                </div>
            </div>
        </div>

        <div class="dashboard-content">
            <!-- Quick Actions -->
            <div class="action-section">
                <h3>Quick Actions</h3>
                <div class="action-buttons">
                    <a href="/worker/tasks" class="action-card primary">
                        <i class="fas fa-tasks"></i>
                        <span>View My Tasks</span>
                        <i class="fas fa-arrow-right arrow"></i>
                    </a>
                    <a href="/worker/profile" class="action-card secondary">
                        <i class="fas fa-user-edit"></i>
                        <span>Update Profile</span>
                        <i class="fas fa-arrow-right arrow"></i>
                    </a>
                    <a href="/worker/history" class="action-card secondary">
                        <i class="fas fa-history"></i>
                        <span>Work History</span>
                        <i class="fas fa-arrow-right arrow"></i>
                    </a>
                </div>
            </div>

            <!-- Recent Tasks Preview -->
            <div class="recent-section">
                <div class="section-header">
                    <h3>Recent Assignments</h3>
                    <a href="/worker/tasks">View All</a>
                </div>

                <div class="mini-task-list">
                    <% if(recentTasks.length===0) { %>
                        <p class="empty-state">No active tasks currently.</p>
                        <% } else { %>
                            <% recentTasks.forEach(task=> { %>
                                <div class="mini-task-card">
                                    <div class="task-icon cat-<%= task.category.toLowerCase() %>">
                                        <i class="fas fa-<%= 
                                    task.category === 'Road' ? 'road' : 
                                    task.category === 'Sanitation' ? 'trash' : 
                                    task.category === 'Water' ? 'water' : 'bolt' 
                                %>"></i>
                                    </div>
                                    <div class="task-info">
                                        <h4>
                                            <%= task.category %> Issue
                                        </h4>
                                        <p>
                                            <%= task.description.substring(0, 40) %>...
                                        </p>
                                    </div>
                                    <span class="status-pill <%= task.status.toLowerCase().replace(' ', '-') %>">
                                        <%= task.status %>
                                    </span>
                                </div>
                                <% }) %>
                                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <style>
        .dashboard-container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1.5rem;
        }

        .welcome-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 2.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .welcome-text h2 {
            font-size: 2rem;
            margin: 0 0 0.5rem 0;
            background: linear-gradient(135deg, #fff 0%, #cbd5e1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .welcome-text p {
            color: rgba(255, 255, 255, 0.7);
            margin: 0;
            font-size: 1.1rem;
        }

        .date-display {
            background: rgba(255, 255, 255, 0.1);
            padding: 0.5rem 1rem;
            border-radius: 8px;
            color: #94a3b8;
            font-size: 0.9rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 1.5rem;
            border-radius: 16px;
            display: flex;
            align-items: center;
            gap: 1.5rem;
            transition: transform 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            background: rgba(255, 255, 255, 0.08);
        }

        .icon-wrapper {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .pending .icon-wrapper {
            background: rgba(59, 130, 246, 0.2);
            color: #60a5fa;
        }

        .completed .icon-wrapper {
            background: rgba(16, 185, 129, 0.2);
            color: #34d399;
        }

        .performance .icon-wrapper {
            background: rgba(245, 158, 11, 0.2);
            color: #fbbf24;
        }

        .stat-info h3 {
            font-size: 2rem;
            margin: 0;
            color: white;
            line-height: 1;
        }

        .stat-info p {
            margin: 0.5rem 0 0 0;
            color: #94a3b8;
            font-size: 0.9rem;
        }

        /* Dashboard Content Split */
        .dashboard-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }

        @media (max-width: 768px) {
            .dashboard-content {
                grid-template-columns: 1fr;
            }
        }

        /* Action Section */
        .action-section h3,
        .recent-section h3 {
            color: white;
            margin-bottom: 1.5rem;
            font-size: 1.25rem;
        }

        .action-buttons {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .action-card {
            display: flex;
            align-items: center;
            padding: 1.25rem;
            border-radius: 12px;
            text-decoration: none;
            transition: all 0.3s;
        }

        .action-card.primary {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
        }

        .action-card.secondary {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #e2e8f0;
        }

        .action-card:hover {
            transform: translateX(5px);
        }

        .action-card.secondary:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        .action-card i:first-child {
            width: 30px;
            font-size: 1.2rem;
        }

        .action-card span {
            flex: 1;
            font-weight: 500;
            margin-left: 0.5rem;
        }

        /* Recent Section */
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .section-header h3 {
            margin: 0;
        }

        .section-header a {
            color: #3b82f6;
            text-decoration: none;
            font-size: 0.9rem;
        }

        .mini-task-list {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 16px;
            padding: 0.5rem;
        }

        .mini-task-card {
            display: flex;
            align-items: center;
            padding: 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            gap: 1rem;
            color: white;
        }

        .mini-task-card:last-child {
            border-bottom: none;
        }

        .task-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .task-icon.cat-road {
            background: rgba(67, 56, 202, 0.2);
        }

        .task-icon.cat-sanitation {
            background: rgba(134, 25, 143, 0.2);
        }

        .task-icon.cat-water {
            background: rgba(22, 78, 99, 0.2);
        }

        .task-info {
            flex: 1;
        }

        .task-info h4 {
            margin: 0 0 0.25rem 0;
            font-size: 0.95rem;
        }

        .task-info p {
            margin: 0;
            color: #94a3b8;
            font-size: 0.8rem;
        }

        .status-pill {
            font-size: 0.75rem;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.1);
        }

        .status-pill.assigned {
            color: #60a5fa;
            background: rgba(96, 165, 250, 0.1);
        }

        .status-pill.in-progress {
            color: #fbbf24;
            background: rgba(251, 191, 36, 0.1);
        }

        .empty-state {
            text-align: center;
            color: #94a3b8;
            padding: 2rem;
        }
    </style>

    <%- include('../partials/footer') %>